{
  "name": "jsnap",
  "version": "0.4.2",
  "private": true,
  "description": "One-click page-to-JSON. BYOK. Free forever.",
  "author": "Karim Elhakim",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/KarimElhakim/jsnap#readme",
  "bugs": {
    "url": "https://github.com/KarimElhakim/jsnap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarimElhakim/jsnap.git"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/karimali"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/KarimElhakim"
    }
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "node scripts/package.mjs",
    "precheck": "npm run lint && npm run build",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css,html}\"",
    "lint": "npm run format:check"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "lucide-preact": "^0.460.0",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@preact/preset-vite": "^2.9.0",
    "prettier": "^3.3.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "json",
    "extraction",
    "llm",
    "gemini",
    "groq",
    "ollama",
    "byok"
  ]
